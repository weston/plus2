{
  "name": "plus2",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "db:migrate": "npm run migration:run -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "postinstall": "npx patch-package"
  },
  "dependencies": {
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.61.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
